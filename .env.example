# Variables de entorno
# Copia este archivo a .env.local para desarrollo.

DATABASE_URL="postgresql://habitactive:habitactive@localhost:5432/habitactive?schema=public"

# Genera uno con: openssl rand -base64 32
NEXTAUTH_SECRET="cambia-esto-por-un-secreto-de-32-bytes-como-minimo"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Opcional: correo de contacto que aparece en la política de privacidad.
NEXT_PUBLIC_CONTACT_EMAIL="privacidad@habitactive.app"
