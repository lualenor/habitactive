{
  "name": "habitactive",
  "version": "1.0.0",
  "private": true,
  "description": "Habitactive: PWA open source de hábitos y retos en comunidad.",
  "license": "MIT",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "5.3.0",
    "@prisma/client": "6.16.3",
    "bcryptjs": "3.0.2",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "next": "14.2.35",
    "next-auth": "4.24.11",
    "prisma": "6.16.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "0.34.3",
    "sonner": "2.0.7",
    "tailwind-merge": "2.6.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "autoprefixer": "10.4.21",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "vitest": "2.1.9"
  }
}
